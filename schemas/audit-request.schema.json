{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xinyuan20061/WARDEN/schemas/audit-request.schema.json",
  "title": "WARDEN Audit Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "contract_id", "model_id", "runtime_id", "mode"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": "string", "minLength": 1},
    "mode": {
      "enum": ["capture_only", "detection", "causal_audit", "defense_evaluation"]
    },
    "probe_id": {"type": ["string", "null"]},
    "sae_id": {"type": ["string", "null"]},
    "research_protocol_ref": {"type": ["string", "null"], "minLength": 1},
    "study_arm_ref": {"type": ["string", "null"], "minLength": 1},
    "capture_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "agent_ids"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "agent_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "module": {"type": ["string", "null"]},
          "layer": {"type": ["integer", "null"], "minimum": 0},
          "component": {"type": ["string", "null"]},
          "token_policy": {"enum": ["all", "last_token", "mean_tokens"]},
          "retain_gradient": {"type": "boolean"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
