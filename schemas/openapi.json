{
  "openapi": "3.1.0",
  "info": {
    "title": "WARDEN API",
    "description": "多智能体有害交互的因果审计及可控防御内核接口。",
    "version": "0.4.0rc1"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Health",
        "description": "返回服务状态，不把组件不可用伪装成服务崩溃。",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Capabilities",
        "description": "返回全部 Adapter 的能力与不可用原因。",
        "operationId": "capabilities_v1_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Capabilities V1 Capabilities Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/resources": {
      "get": {
        "summary": "Resources",
        "description": "返回平台可选择的 Probe 与 SAE 清单。",
        "operationId": "resources_v1_resources_get",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(probe|sae)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contracts": {
      "get": {
        "summary": "Contracts",
        "description": "返回当前威胁来源中的契约标识。",
        "operationId": "contracts_v1_contracts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response Contracts V1 Contracts Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit-plans": {
      "post": {
        "summary": "Create Audit Plan",
        "description": "编译审计计划，缺失训练资源时返回 blocked 状态和原因。",
        "operationId": "create_audit_plan_v1_audit_plans_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditRequestSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Audit Plans",
        "description": "返回当前进程登记的计划。",
        "operationId": "audit_plans_v1_audit_plans_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/audit-plans/{plan_id}": {
      "get": {
        "summary": "Audit Plan",
        "description": "返回单个计划。",
        "operationId": "audit_plan_v1_audit_plans__plan_id__get",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "summary": "Start Run",
        "description": "提交计划；执行器未就绪时返回可追踪的 blocked 任务。",
        "operationId": "start_run_v1_runs_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequestSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Runs",
        "description": "返回当前进程可见的任务快照。",
        "operationId": "runs_v1_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "summary": "Run",
        "description": "返回单个任务的最新快照。",
        "operationId": "run_v1_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/artifacts/{artifact_id}/content": {
      "get": {
        "summary": "Artifact Content",
        "description": "经操作者授权读取白名单公共摘要；不接受路径或 URI。",
        "operationId": "artifact_content_v1_artifacts__artifact_id__content_get",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artifact Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditMode": {
        "type": "string",
        "enum": [
          "capture_only",
          "detection",
          "causal_audit",
          "defense_evaluation"
        ],
        "title": "AuditMode",
        "description": "审计任务允许执行的方法范围。"
      },
      "AuditRequestSchema": {
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "title": "Request Id"
          },
          "contract_id": {
            "type": "string",
            "minLength": 1,
            "title": "Contract Id"
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "title": "Model Id"
          },
          "runtime_id": {
            "type": "string",
            "minLength": 1,
            "title": "Runtime Id"
          },
          "mode": {
            "$ref": "#/components/schemas/AuditMode",
            "default": "causal_audit"
          },
          "probe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Probe Id"
          },
          "sae_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sae Id"
          },
          "capture_targets": {
            "items": {
              "$ref": "#/components/schemas/CaptureTargetSchema"
            },
            "type": "array",
            "title": "Capture Targets"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "research_protocol_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Research Protocol Ref"
          },
          "study_arm_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Study Arm Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "contract_id",
          "model_id",
          "runtime_id"
        ],
        "title": "AuditRequestSchema",
        "description": "创建审计计划的版本化请求。"
      },
      "CaptureTargetSchema": {
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1,
            "title": "Target Id"
          },
          "agent_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Agent Ids"
          },
          "module": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Module"
          },
          "layer": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Layer"
          },
          "component": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Component",
            "default": "resid_post"
          },
          "token_policy": {
            "type": "string",
            "title": "Token Policy",
            "default": "last_token"
          },
          "retain_gradient": {
            "type": "boolean",
            "title": "Retain Gradient",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_id",
          "agent_ids"
        ],
        "title": "CaptureTargetSchema",
        "description": "REST API 中的模型内部采集位置。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunRequestSchema": {
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "title": "Plan Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan_id"
        ],
        "title": "RunRequestSchema",
        "description": "启动一个已编译审计计划。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
